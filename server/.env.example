NODE_ENV=development
PORT=5000
# Public URL of this API (used to build URLs for locally stored uploads)
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/nail_studio

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Cloudinary (optional; if unset, assets are stored in ./uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nail-studio

# Background removal provider: auto | imgly | cloudinary | none
#   auto       -> imgly if installed, otherwise none
#   cloudinary -> needs the Cloudinary AI Background Removal add-on
BG_REMOVAL_PROVIDER=auto
# imgly model: small | medium
IMGLY_MODEL=medium
# Default skin-removal tolerance (larger value = removes more skin-like colour). Range 0.5-5
DEFAULT_SKIN_TOLERANCE=2.5

# Studio schedule (all times are in STUDIO_TIMEZONE)
STUDIO_TIMEZONE=Asia/Yangon
OPEN_TIME=10:00
CLOSE_TIME=19:00
SLOT_MINUTES=60
# Comma-separated weekdays the studio is closed (0=Sunday ... 6=Saturday)
CLOSED_WEEKDAYS=0
# How many days ahead customers can book
BOOKING_WINDOW_DAYS=60

# Seed admin
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=admin@nailstudio.local
ADMIN_PASSWORD=ChangeMe123!

# ---- Generative AI try-on (Replicate) ----
# Get a token at https://replicate.com/account/api-tokens. Leave empty to disable AI try-on.
# Each generation is billed by Replicate to your account.
REPLICATE_API_TOKEN=
# multi-image | inpaint | custom  (run 'npm run replicate:schema' to see the model's real input fields)
REPLICATE_PRESET=multi-image
# Leave empty to use the preset's default model. 'owner/name' or 'owner/name:version'
REPLICATE_MODEL=
# Only for REPLICATE_PRESET=custom. JSON; placeholders {{prompt}} {{photo}} {{mask}} {{pattern}} are replaced
# REPLICATE_INPUT_TEMPLATE={"prompt":"{{prompt}}","image":"{{photo}}","mask":"{{mask}}"}
REPLICATE_TIMEOUT_MS=180000
# Which design asset is sent as the pattern: isolated (all nails) | swatch (one nail texture)
TRYON_PATTERN_SOURCE=isolated
# Limits: generations per user per hour, per day across everyone, and days results are kept
TRYON_RATE_PER_HOUR=10
TRYON_DAILY_LIMIT=200
TRYON_RETENTION_DAYS=30

# Pricing: percent off when a booking includes both a service and a nail design (0 = off)
COMBO_DISCOUNT_PERCENT=5

# ---- Outgoing email (admin broadcasts) ----
# Leave SMTP_HOST empty to disable. Gmail: smtp.gmail.com, port 465, and an App Password (not your login password).
SMTP_HOST=
SMTP_PORT=587
# true for port 465; leave unset to infer from the port
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. "Nail Studio <hello@yourstudio.com>"
MAIL_FROM=
STUDIO_NAME=Nail Studio
# How many messages are sent at once during a broadcast
MAIL_CONCURRENCY=5
